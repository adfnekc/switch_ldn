 }
 
diff --git a/os_dep/linux/usb_intf.c b/os_dep/linux/usb_intf.c
index a326c3f..f9b5759 100644
--- a/os_dep/linux/usb_intf.c
+++ b/os_dep/linux/usb_intf.c
@@ -360,7 +360,7 @@ struct rtw_usb_drv usb_drv = {
